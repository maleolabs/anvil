{
    "$schema": "urn:anvil:spec:command-contract:1.0.0",
    "id": "negative-invented-exchange-rule",
    "contractVersion": "1.0.0",
    "frameworkVersion": ["7.2.0"],
    "title": "Negative: invented exchange rule",
    "description": "Violates command-contract.md §4.6 (C2; Manifesto §3.1): exchangeRules adds an invented rule 'phasesSkippable' asserted true — declaring phases skippable. The rule set is fixed by the contract: C1–C7 plus the declared-surface bound; an invented rule that weakens the executed-order guarantee is undeclared capability and is rejected by exchangeRules additionalProperties.",
    "capability": {
        "lifecyclePhases": [],
        "verificationChecks": [],
        "configExtensions": [],
        "templates": []
    },
    "lifecycleExchange": {
        "activation": {
            "phaseSequence": "prepare,configure,verify,promote"
        },
        "rollback": {
            "isForwardTransition": true,
            "restoresPreviouslyActiveRelease": true,
            "executesDeclaredPerPhaseReversal": true
        }
    },
    "verificationExchange": {
        "position": "verify",
        "rules": {
            "positionFixedBeforePromotion": true,
            "zeroDeclaredChecksKeepsNoOpGate": true,
            "standardAddsChecksNeverWeakensGates": true,
            "outcomesMergeIntoVerificationReport": true
        }
    },
    "configurationExchange": {
        "namespaceIsolationEnforced": true,
        "valuesPassedThrough": true,
        "extensionsTravelWithStandard": true
    },
    "exchangeRules": {
        "onlyDeclaredCapabilityInvoked": true,
        "declaredOrderIsExecutedOrder": true,
        "contentWithinDefinedLifecycle": true,
        "irreversibilityNeverBlocksRollback": true,
        "checksAddNeverWeaken": true,
        "standardValidatesOwnConfiguration": true,
        "contractViolationIsRejected": true,
        "emptyDeclarationProceedsWithGenericOperations": true,
        "phasesSkippable": true
    }
}
