{
    "$schema": "urn:anvil:spec:command-contract:1.0.0",
    "id": "negative-missing-verification-exchange",
    "contractVersion": "1.0.0",
    "frameworkVersion": ["7.2.0"],
    "title": "Negative: verification exchange omitted",
    "description": "Violates command-contract.md §4.4 (lifecycle-model.md §5.1): the verification exchange — the fixed pre-promote position and its exchange rules — is omitted entirely. Verification is a lifecycle gate, not an optional command: the position remains even when zero checks are declared (a no-op gate, not an open door); a declaration that omits the exchange cannot affirm the no-op gate bound or the adds-never-weakens rule. Root required rejects the missing section.",
    "capability": {
        "lifecyclePhases": [],
        "verificationChecks": [],
        "configExtensions": [],
        "templates": []
    },
    "lifecycleExchange": {
        "activation": {
            "phaseSequence": "prepare,configure,verify,promote"
        },
        "rollback": {
            "isForwardTransition": true,
            "restoresPreviouslyActiveRelease": true,
            "executesDeclaredPerPhaseReversal": true
        }
    },
    "configurationExchange": {
        "namespaceIsolationEnforced": true,
        "valuesPassedThrough": true,
        "extensionsTravelWithStandard": true
    },
    "exchangeRules": {
        "onlyDeclaredCapabilityInvoked": true,
        "declaredOrderIsExecutedOrder": true,
        "contentWithinDefinedLifecycle": true,
        "irreversibilityNeverBlocksRollback": true,
        "checksAddNeverWeaken": true,
        "standardValidatesOwnConfiguration": true,
        "contractViolationIsRejected": true,
        "emptyDeclarationProceedsWithGenericOperations": true
    }
}
