{
    "$schema": "urn:anvil:spec:lifecycle-model:1.0.0",
    "id": "negative-rollback-target-not-archived",
    "contractVersion": "1.0.0",
    "title": "Negative: rollback target state is not Archived",
    "description": "Violates R5 / §5.2 (rollback legality is defined by state): the rollback target — the Archived Release with the newest archival timestamp among Releases that were previously Active — must be in state Archived. Declaring any other target state (here 'Active') is rejected; if the eligibility condition fails, the rollback operation is rejected.",
    "states": {
        "Ready": {
            "transitions": ["Activating", "Archived", "Removed"]
        },
        "Activating": {
            "transitions": ["Active", "Rolling Back", "Failed"]
        },
        "Active": {
            "transitions": ["Rolling Back", "Archived"]
        },
        "Rolling Back": {
            "transitions": ["Rolled Back", "Failed"]
        },
        "Rolled Back": {
            "transitions": ["Archived", "Removed"]
        },
        "Archived": {
            "transitions": ["Active", "Removed"]
        },
        "Failed": {
            "transitions": ["Ready", "Archived", "Removed"]
        },
        "Removed": {
            "transitions": []
        }
    },
    "activation": {
        "phaseSequence": "prepare,configure,migrate,verify,promote",
        "verify": {
            "checks": []
        }
    },
    "rollback": {
        "targetSelection": "newest-archived-previously-active",
        "targetState": "Active"
    },
    "installation": {
        "operation": "install",
        "createsState": "Ready",
        "isStateTransition": false
    },
    "invariants": {
        "oneActiveRelease": true,
        "activationIsAtomic": true,
        "interruptedIsNotAState": true
    }
}
