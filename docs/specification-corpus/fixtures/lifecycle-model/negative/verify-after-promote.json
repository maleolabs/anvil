{
    "$schema": "urn:anvil:spec:lifecycle-model:1.0.0",
    "id": "negative-verify-after-promote",
    "contractVersion": "1.0.0",
    "title": "Negative: verify placed after promote",
    "description": "Violates §5.1 / ADR-003 §6.4: the verify position is FIXED immediately before promote — verify is the post-activation verification gate before the atomic commitment, and nothing may run after the commitment point (§5.1: nothing after the commitment point is assumed). The schema rejects the sequence 'prepare,configure,promote,verify' because verify must be the penultimate phase.",
    "states": {
        "Ready": {
            "transitions": ["Activating", "Archived", "Removed"]
        },
        "Activating": {
            "transitions": ["Active", "Rolling Back", "Failed"]
        },
        "Active": {
            "transitions": ["Rolling Back", "Archived"]
        },
        "Rolling Back": {
            "transitions": ["Rolled Back", "Failed"]
        },
        "Rolled Back": {
            "transitions": ["Archived", "Removed"]
        },
        "Archived": {
            "transitions": ["Active", "Removed"]
        },
        "Failed": {
            "transitions": ["Ready", "Archived", "Removed"]
        },
        "Removed": {
            "transitions": []
        }
    },
    "activation": {
        "phaseSequence": "prepare,configure,promote,verify",
        "verify": {
            "checks": []
        }
    },
    "rollback": {
        "targetSelection": "newest-archived-previously-active",
        "targetState": "Archived"
    },
    "installation": {
        "operation": "install",
        "createsState": "Ready",
        "isStateTransition": false
    },
    "invariants": {
        "oneActiveRelease": true,
        "activationIsAtomic": true,
        "interruptedIsNotAState": true
    }
}
